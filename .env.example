# ARIA Unified Environment Configuration

# Flask Core
SECRET_KEY=dev-secret-key-change-in-production
FLASK_APP=main.py
FLASK_ENV=development
FLASK_DEBUG=True

# Database (Using container name 'db' as host)
DATABASE_URL=mysql+mysqldb://root:rootpassword@db:3306/ariadb
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ariadb

# Redis (Using container name 'redis' as host)
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Mail Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_TLS=False
MAIL_USE_SSL=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Face Recognition
FACE_CONFIDENCE_THRESHOLD=0.85
SESSION_LIFETIME_MINUTES=480

# Pi Simulator Specific
SIMULATOR_TEST_IMAGES_PATH=/app/test_images
SIMULATOR_RECOGNITION_INTERVAL=5
